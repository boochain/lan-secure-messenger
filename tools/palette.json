    "map": {
      "window_bg": [
        "SolidBackgroundFillColorBase",
        "COLOR_3DFACE (system, high-contrast aware) / custom brush = unified hex",
        "@window_bg_color",
        "surface"
      ],
      "sidebar_bg": [
        "SolidBackgroundFillColorSecondary",
        "custom brush",
        "@sidebar_bg_color",
        "surfaceContainerLow"
      ],
      "card_bg": [
        "CardBackgroundFillColorDefault",
        "COLOR_WINDOW",
        "@card_bg_color",
        "surfaceContainer"
      ],
      "chat_bg": [
        "LayerFillColorDefault",
        "COLOR_WINDOW",
        "@view_bg_color",
        "surfaceContainerLowest"
      ],
      "bubble_in_bg": [
        "CardBackgroundFillColorDefault",
        "custom brush",
        "@card_bg_color",
        "surfaceContainerHigh"
      ],
      "bubble_out_bg": [
        "AccentFillColorDefault",
        "custom brush",
        "@accent_bg_color",
        "primary"
      ],
      "bubble_out_fg": [
        "TextOnAccentFillColorPrimary",
        "custom",
        "@accent_fg_color",
        "onPrimary"
      ],
      "text_primary": [
        "TextFillColorPrimary",
        "COLOR_WINDOWTEXT",
        "@window_fg_color",
        "onSurface"
      ],
      "text_secondary": [
        "TextFillColorSecondary",
        "COLOR_GRAYTEXT (only if >=4.5)",
        "@window_fg_color + .dim-label",
        "onSurfaceVariant"
      ],
      "accent": [
        "AccentTextFillColorPrimary",
        "COLOR_HOTLIGHT",
        "@accent_color",
        "primary"
      ],
      "divider": [
        "DividerStrokeColorDefault",
        "COLOR_3DSHADOW",
        "@borders",
        "outlineVariant"
      ],
      "online": [
        "SystemFillColorSuccess",
        "custom",
        "@success_color",
        "custom (M3 has no success role) = unified hex"
      ],
      "warning": [
        "SystemFillColorCaution",
        "custom",
        "@warning_color",
        "custom = unified hex"
      ],
      "error": [
        "SystemFillColorCritical",
        "custom",
        "@error_color",
        "error"
      ],
      "badge_bg": [
        "SystemFillColorCritical",
        "custom",
        "@error_bg_color (bg) \u2014 use unified hex",
        "error"
      ]
    }

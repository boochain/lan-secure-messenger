<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LanMessenger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Han unification: on non-Chinese Windows the default fallback picks a Japanese font and renders
                 simplified characters (e.g. 组) with Japanese glyphs. Put a Simplified Chinese font right after Segoe. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, SimSun</FontFamily>
            <FontFamily x:Key="CjkFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, SimSun</FontFamily>
            <local:PathToImageConverter x:Key="PathToImage" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="UnreadBrush" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

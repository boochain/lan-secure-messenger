            <!-- App-specific colours. Never use literal colours in pages: every brush here has a Light, Dark and
                 HighContrast variant and must be referenced with {ThemeResource ...} so it follows live theme changes. -->
            <!-- Unified palette (design/palette.json, Fluent 2 values; identical hex on WinUI, XP, GTK and Android).
                 Light/Dark override the framework brushes, and the accent is PINNED to the palette blue: in beta.2 the
                 accent followed the Windows accent colour, so a dark OS accent gave black TextOnAccent text on a near-black
                 accent fill (sent bubbles, 发送 button) in dark mode. HighContrast keeps the system colours. -->

            <!-- Han unification: on non-Chinese Windows the default fallback picks a Japanese font and renders
                 simplified characters (e.g. 组) with Japanese glyphs. Put a Simplified Chinese font right after Segoe. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
            <FontFamily x:Key="CjkFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
            <local:PathToImageConverter x:Key="PathToImage" />

            <!-- Shared card style (settings, diagnostics, groups). -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <!-- Secondary/tertiary text: use theme text brushes instead of Opacity so contrast is right in every theme
                 (Opacity on text breaks High Contrast and gives muddy text on Mica). -->
            <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TitleBarActiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TitleBarInactiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryBodyStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>

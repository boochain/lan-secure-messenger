<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    xmlns:vm="using:LanMessenger.Core.ViewModels"
    Background="Transparent">
    <Grid Padding="16,4,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="群组" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="群消息使用群密钥加密；移除成员后会自动更换密钥（rekey）。只能邀请已信任的联系人。"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Create_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="创建群组" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Grid.Row="1" Text="还没有群组。" Opacity="0.6" Visibility="{x:Bind local:B.Empty(VM.Groups.Count), Mode=OneWay}" />
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{x:Bind VM.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupItem">
                        <Border CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <FontIcon Glyph="&#xE74F;" FontSize="12" Opacity="0.6" Visibility="{x:Bind Muted, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                                        <Run Text="{x:Bind MembersText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind EpochText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="打开聊天" Click="Open_Click" />
                                    <Button Content="邀请" Click="Invite_Click" Visibility="{x:Bind IsCreator, Mode=OneWay}" />
                                    <Button Content="退出" Click="Leave_Click" />
                                </StackPanel>
                                <ItemsRepeater Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{x:Bind Members}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="220" MinColumnSpacing="8" MinRowSpacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupMemberItem">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource OnlineBrush}" Visibility="{x:Bind Online, Mode=OneWay}" />
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource OfflineBrush}" Visibility="{x:Bind local:B.Not(Online), Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <HyperlinkButton Grid.Column="2" Content="移除" Padding="4,0" Click="RemoveMember_Click" Tag="{x:Bind Fingerprint}"
                                                                 Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>

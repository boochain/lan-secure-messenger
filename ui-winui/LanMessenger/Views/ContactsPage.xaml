<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    xmlns:vm="using:LanMessenger.Core.ViewModels"
    Background="Transparent">
    <Grid Padding="16,4,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="联系人" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="LSMF_nav_contacts" />
            <TextBlock Text="同一局域网内发现的设备。点一项即可打开聊天。"
                       Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1"
                   Text="还没有联系人。同一 Wi-Fi 下运行本软件的设备会自动出现在这里。"
                   Visibility="{x:Bind local:B.Empty(VM.Peers.Count), Mode=OneWay}" />
        <ListView Grid.Row="1" ItemsSource="{x:Bind VM.Peers}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Peer_Click">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PeerItem">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind Initial, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                <Run Text="{x:Bind TrustText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind StateText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

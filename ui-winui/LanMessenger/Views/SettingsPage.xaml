<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    Background="Transparent">
    <ScrollViewer><!-- padding lives on the content: ScrollViewer.Padding clipped cards 16px above the edge with no border (audit: indistinct card/page) -->
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch" Margin="16,4,16,16">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="个人资料" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="显示名称" Text="{x:Bind VM.EditDisplayName, Mode=TwoWay}" MaxLength="40" />
                    <TextBlock Text="身份指纹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind VM.MyFingerprint, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                        <Button Content="复制" Command="{x:Bind VM.CopyFingerprintCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeChoice" Header="主题" MaxColumns="3" SelectionChanged="ThemeChoice_SelectionChanged">
                        <x:String>跟随系统</x:String>
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                    </RadioButtons>
                    <TextBlock Text="“跟随系统”会随 Windows 的深色/浅色模式实时切换。" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="文件" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="下载文件夹（留空使用默认）" Text="{x:Bind VM.EditDownloadDir, Mode=TwoWay}" PlaceholderText="{x:Bind VM.DownloadDir, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Command="{x:Bind VM.PickDownloadDirCommand}" />
                    </Grid>
                    <ToggleSwitch Header="自动接收已信任联系人发来的文件" IsOn="{x:Bind VM.EditAutoAccept, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <NumberBox Header="单个文件大小上限 (MB)" Value="{x:Bind VM.EditMaxFileMb, Mode=TwoWay}" Minimum="1" Maximum="1048576"
                               SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" MinWidth="220" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="网络与发现" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch Header="自动发现局域网内的其他人（UDP 广播）" IsOn="{x:Bind VM.EditDiscovery, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <ToggleSwitch Header="同时使用组播（部分路由器/交换机需要）" IsOn="{x:Bind VM.EditMulticast, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <TextBox Header="额外发现目标（IP 或 IP:端口，逗号分隔；跨网段时使用）" Text="{x:Bind VM.EditTargets, Mode=TwoWay}"
                             PlaceholderText="例如 192.168.2.255, 10.0.0.8" />
                    <TextBox Header="只使用这些网卡（名称或 IP，逗号分隔；留空=自动）" Text="{x:Bind VM.EditInclude, Mode=TwoWay}" />
                    <TextBox Header="排除这些网卡（名称或 IP，逗号分隔）" Text="{x:Bind VM.EditExclude, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind VM.PortsText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="隐私" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch Header="保存聊天记录（本地加密存储）" IsOn="{x:Bind VM.EditHistory, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <ToggleSwitch Header="启动时检查更新（访问 GitHub）" IsOn="{x:Bind VM.EditCheckUpdates, Mode=TwoWay}" OnContent="开" OffContent="关" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="保存设置" Command="{x:Bind VM.SaveSettingsCommand}" />
                <Button Content="重启后台服务" Command="{x:Bind VM.RestartDaemonCommand}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份与恢复" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="备份包含身份密钥、联系人、群组和聊天记录，使用你设置的密码加密（Argon2id + ChaCha20-Poly1305）。恢复会覆盖当前数据并重启后台服务。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="创建备份…" Click="Backup_Click" />
                        <Button Content="从备份恢复…" Click="Restore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock>
                        <Run Text="版本 " /><Run Text="{x:Bind VM.Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VM.UpdateText, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:B.NotEmpty(VM.UpdateText), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap">
                        <Run Text="数据目录：" /><Run Text="{x:Bind VM.DataDir, Mode=OneWay}" /><LineBreak />
                        <Run Text="日志目录：" /><Run Text="{x:Bind VM.LogDir, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查更新" Command="{x:Bind VM.CheckUpdateCommand}" />
                        <Button Content="打开日志文件夹" Command="{x:Bind VM.OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    Background="Transparent">
    <ScrollViewer><!-- padding lives on the content: ScrollViewer.Padding clipped cards 16px above the edge with no border (audit: indistinct card/page) -->
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch" Margin="16,4,16,16">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="个人资料" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="显示名称" Text="{x:Bind VM.EditDisplayName, Mode=TwoWay}" MaxLength="40" />
                    <TextBlock Text="身份指纹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind VM.MyFingerprint, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                        <Button Content="复制" Command="{x:Bind VM.CopyFingerprintCommand}" />
                    </StackPanel>
                    <Button Content="头像与个性签名…" Click="Profile_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeChoice" Header="主题" MaxColumns="3" SelectionChanged="ThemeChoice_SelectionChanged">
                        <x:String>跟随系统</x:String>
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                    </RadioButtons>
                    <TextBlock Text="“跟随系统”会随 Windows 的深色/浅色模式实时切换。" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="文件" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="下载文件夹（留空使用默认）" Text="{x:Bind VM.EditDownloadDir, Mode=TwoWay}" PlaceholderText="{x:Bind VM.DownloadDir, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Command="{x:Bind VM.PickDownloadDirCommand}" />
                    </Grid>
                    <ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭窗口时最小化到通知区域（继续接收消息）" OnContent="开" OffContent="关（关闭窗口即退出界面）" Toggled="CloseToTray_Toggled" />
                    <ToggleSwitch Header="自动接收已信任联系人发来的文件" IsOn="{x:Bind VM.EditAutoAccept, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <NumberBox Header="单个文件大小上限 (MB)" Value="{x:Bind VM.EditMaxFileMb, Mode=TwoWay}" Minimum="1" Maximum="1048576"
                               SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" MinWidth="220" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="网络与发现" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch Header="自动发现局域网内的其他人（UDP 广播）" IsOn="{x:Bind VM.EditDiscovery, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <ToggleSwitch Header="同时使用组播（部分路由器/交换机需要）" IsOn="{x:Bind VM.EditMulticast, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <TextBox Header="额外发现目标（IP 或 IP:端口，逗号分隔；跨网段时使用）" Text="{x:Bind VM.EditTargets, Mode=TwoWay}"
                             PlaceholderText="例如 192.168.2.255, 10.0.0.8" />
                    <TextBox Header="只使用这些网卡（名称或 IP，逗号分隔；留空=自动）" Text="{x:Bind VM.EditInclude, Mode=TwoWay}" />
                    <TextBox Header="排除这些网卡（名称或 IP，逗号分隔）" Text="{x:Bind VM.EditExclude, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind VM.PortsText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
            </Border>

            <!-- 中转服务器（可选）: off by default; LAN direct is always preferred, the server only forwards E2E-encrypted data -->
            <Border x:Name="RelayCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="中转服务器（可选）" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                               Text="不在同一局域网时，可通过你自己部署的中转服务器联系对方。局域网直连始终优先；服务器只转发端到端加密的数据，无法看到消息内容。" />
                    <ToggleSwitch x:Name="RelayToggle" Header="通过中转服务器连接" IsOn="{x:Bind VM.EditRelayEnabled, Mode=TwoWay}" OnContent="开" OffContent="关"
                                  ToolTipService.ToolTip="关闭时只使用局域网直连" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RelayHostBox" Header="服务器地址" PlaceholderText="例如 relay.example.com 或 203.0.113.5"
                                 Text="{x:Bind VM.EditRelayHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Relay_KeyDown"
                                 ToolTipService.ToolTip="中转服务器的域名或 IP" AutomationProperties.Name="中转服务器地址" />
                        <NumberBox x:Name="RelayPortBox" Grid.Column="1" Header="端口" Value="{x:Bind VM.EditRelayPort, Mode=TwoWay}" Minimum="1" Maximum="65535"
                                   SpinButtonPlacementMode="Hidden" MinWidth="120" KeyDown="Relay_KeyDown" ToolTipService.ToolTip="默认 9443" AutomationProperties.Name="中转服务器端口" />
                    </Grid>
                    <!-- v0.6.0+: relay is open by default; no client passphrase -->
                    <!-- status indicator (docs/ipc.md: connecting / online / auth_failed / error) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind VM.RelayDetail, Mode=OneWay}">
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse Tag="lsm-icon" Fill="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind local:B.Is(VM.RelayStateKind, 0), Mode=OneWay}" />
                            <Ellipse Tag="lsm-icon" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:B.Is(VM.RelayStateKind, 1), Mode=OneWay}" />
                            <Ellipse Tag="lsm-icon" Fill="{ThemeResource StatusOnlineBrush}" Visibility="{x:Bind local:B.Is(VM.RelayStateKind, 2), Mode=OneWay}" />
                            <Ellipse Tag="lsm-icon" Fill="{ThemeResource StatusErrorTextBrush}" Visibility="{x:Bind local:B.Is(VM.RelayStateKind, 3), Mode=OneWay}" />
                        </Grid>
                        <TextBlock x:Name="RelayStateLabel" Text="{x:Bind VM.RelayStateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{x:Bind VM.RelayDetail, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RelaySaveButton" Style="{StaticResource AccentButtonStyle}" Content="保存并连接" Command="{x:Bind VM.SaveRelayCommand}"
                                ToolTipService.ToolTip="保存中转服务器设置（Enter）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="隐私" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch Header="保存聊天记录（本地加密存储）" IsOn="{x:Bind VM.EditHistory, Mode=TwoWay}" OnContent="开" OffContent="关" />
                    <ToggleSwitch Header="启动时检查更新（访问 GitHub）" IsOn="{x:Bind VM.EditCheckUpdates, Mode=TwoWay}" OnContent="开" OffContent="关" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="保存设置" Command="{x:Bind VM.SaveSettingsCommand}" />
                <Button Content="重启后台服务" Command="{x:Bind VM.RestartDaemonCommand}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份与恢复" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="备份包含身份密钥、联系人、群组和聊天记录，使用你设置的密码加密（Argon2id + ChaCha20-Poly1305）。恢复会覆盖当前数据并重启后台服务。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="创建备份…" Click="Backup_Click" />
                        <Button Content="从备份恢复…" Click="Restore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>


            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="存储管理" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind VM.StorageSummary, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新用量" Command="{x:Bind VM.RefreshStorageCommand}" />
                        <Button Content="清理半成品与已完成传输" Command="{x:Bind VM.CleanupStorageCommand}"
                                ToolTipService.ToolTip="删除孤儿 .part、失败残留，并清除已完成的传输列表项" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                               Text="传输失败或取消的未续传半成品会自动删除；可续传的中断文件会保留直到成功或手动清理。" />
                </StackPanel>
            </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="局域网与 VPN" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                               Text="绑定本机局域网 IPv4（或 auto）可让发现/监听/拨号绕过 VPN 虚拟网卡。留空则使用系统默认路由。" />
                    <TextBox Header="局域网绑定 IP" Text="{x:Bind VM.BindLanIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空 / auto / 192.168.x.x" />
                    <TextBlock Text="传输与账号" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <ComboBox Header="传输模式" SelectedValue="{x:Bind VM.TransportMode, Mode=TwoWay}" SelectedValuePath="Tag" Width="280">
                        <ComboBoxItem Content="仅局域网" Tag="lan" />
                        <ComboBoxItem Content="服务器 + 局域网（对等）" Tag="server_lan" />
                    </ComboBox>
                    <TextBox Header="中转账号用户名（可选，用于指纹恢复）" Text="{x:Bind VM.AccountUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空=匿名中转" />
                    <PasswordBox x:Name="AccountPassBox" Header="中转账号密码" PasswordChanged="AccountPass_Changed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="注册账号" Click="AccountRegister_Click" />
                        <Button Content="登录账号" Click="AccountLogin_Click" />
                        <Button Content="上传身份备份" Click="AccountBackupPut_Click" />
                        <Button Content="恢复身份备份" Click="AccountBackupGet_Click" />
                        <Button Content="吊销设备指纹" Click="AccountRevoke_Click" />
                    </StackPanel>
                    <ToggleSwitch Header="新消息默认留在服务器（需中转账号）" IsOn="{x:Bind VM.ServerRetainDefault, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="通知" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="NotifyStatusText" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                               Text="正在检测通知通道…" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                               Text="新消息在窗口未聚焦或未打开该会话时弹出系统通知；若系统通知不可用，会尝试托盘气泡提示。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock>
                        <Run Text="版本 " /><Run Text="{x:Bind VM.Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VM.UpdateText, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:B.NotEmpty(VM.UpdateText), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap">
                        <Run Text="数据目录：" /><Run Text="{x:Bind VM.DataDir, Mode=OneWay}" /><LineBreak />
                        <Run Text="日志目录：" /><Run Text="{x:Bind VM.LogDir, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查更新" Command="{x:Bind VM.CheckUpdateCommand}" />
                        <Button Content="打开日志文件夹" Command="{x:Bind VM.OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
    </ScrollViewer>
</Page>

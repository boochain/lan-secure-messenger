<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    xmlns:vm="using:LanMessenger.Core.ViewModels"
    Background="Transparent">
    <Grid Padding="16,4,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{StaticResource LsmIconTileStyle}" VerticalAlignment="Top" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="文件传输" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="LSMF_nav_transfers" />
                    <TextBlock Text="{x:Bind VM.TransfersSummary, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind VM.OpenDownloadsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="打开下载文件夹" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind VM.ClearFinishedTransfersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="清除已完成" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1" Text="暂无传输。在聊天中点击回形针或把文件拖进聊天窗口即可发送。"
                   Visibility="{x:Bind local:B.Empty(VM.Transfers.Count), Mode=OneWay}" />
        <ListView Grid.Row="1" ItemsSource="{x:Bind VM.Transfers}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItem">
                    <Grid Padding="4,10" ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE898;" FontSize="20" Visibility="{x:Bind IsOutgoing, Mode=OneWay}" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="20" Visibility="{x:Bind local:B.Not(IsOutgoing), Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                <Run Text="{x:Bind DirectionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind StateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ProgressText, Mode=OneWay}" />
                            </TextBlock>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind IsActive, Mode=OneWay}" ShowPaused="{x:Bind IsPaused, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Error, Mode=OneWay}" Foreground="{ThemeResource StatusErrorTextBrush}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind IsError, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="取消" Click="Cancel_Click" Visibility="{x:Bind CanCancel, Mode=OneWay}" />
                            <Button Content="重试" Click="Retry_Click" Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                            <Button Content="打开" Click="Open_Click" Visibility="{x:Bind CanOpen, Mode=OneWay}" />
                            <Button Content="所在文件夹" Click="Reveal_Click" Visibility="{x:Bind CanOpen, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

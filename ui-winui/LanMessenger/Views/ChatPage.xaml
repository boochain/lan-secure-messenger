<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    xmlns:vm="using:LanMessenger.Core.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:MessageItem">
            <StackPanel HorizontalAlignment="Left" MaxWidth="560" Margin="0,4,80,4">
                <TextBlock Text="{x:Bind SenderName, Mode=OneWay}" Visibility="{x:Bind ShowSender, Mode=OneWay}"
                           Style="{StaticResource SecondaryCaptionStyle}" Margin="4,0,0,2" />
                <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind IsText, Mode=OneWay}" />
                        <Image Source="{x:Bind FilePath, Mode=OneWay, Converter={StaticResource PathToImage}}" MaxHeight="260" MaxWidth="420"
                               Stretch="Uniform" HorizontalAlignment="Left" Visibility="{x:Bind IsImage, Mode=OneWay}" Tapped="Image_Tapped" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind IsFile, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8A5;" FontSize="22" />
                            <StackPanel>
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                            </StackPanel>
                            <Button Content="打开" Click="OpenFile_Click" Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                            <Button Content="所在文件夹" Click="RevealFile_Click" Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" Margin="4,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:MessageItem">
            <StackPanel HorizontalAlignment="Right" MaxWidth="560" Margin="80,4,0,4">
                <!-- Text: accent bubble with the matching on-accent text brush (dark text on light accent in Dark theme). -->
                <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind IsText, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <!-- Files/images: neutral card with an accent outline, so the normal buttons and text keep their theme contrast
                     (standard buttons on a light-blue accent fill are unreadable in Dark theme). -->
                <Border CornerRadius="10" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource MediaBubbleBorderBrush}" BorderThickness="{ThemeResource MediaBubbleBorderThickness}"
                        Visibility="{x:Bind IsFile, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <Image Source="{x:Bind FilePath, Mode=OneWay, Converter={StaticResource PathToImage}}" MaxHeight="260" MaxWidth="420"
                               Stretch="Uniform" HorizontalAlignment="Right" Visibility="{x:Bind IsImage, Mode=OneWay}" Tapped="Image_Tapped" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="22" />
                            <StackPanel>
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                            </StackPanel>
                            <Button Content="所在文件夹" Click="RevealFile_Click" Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,2,4,0">
                    <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                    <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource StatusErrorTextBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate" x:DataType="vm:MessageItem">
            <TextBlock Text="{x:Bind Body, Mode=OneWay}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource SecondaryCaptionStyle}" Margin="40,6" />
        </DataTemplate>

        <local:MessageTemplateSelector x:Key="MessageSelector"
            Incoming="{StaticResource IncomingTemplate}"
            Outgoing="{StaticResource OutgoingTemplate}"
            SystemNote="{StaticResource SystemTemplate}" />
    </Page.Resources>

    <Grid Padding="0,0,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: conversations -->
        <Grid Grid.Column="0" RowSpacing="8" Padding="12,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox Grid.Row="0" PlaceholderText="搜索聊天记录" QueryIcon="Find"
                            Text="{x:Bind VM.SearchText, Mode=TwoWay}" QuerySubmitted="Search_QuerySubmitted" />
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="按 IP 添加，如 192.168.1.20" Text="{x:Bind VM.AddPeerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="AddPeer_KeyDown" />
                <Button Grid.Column="1" Command="{x:Bind VM.AddPeerCommand}" ToolTipService.ToolTip="添加联系人">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
            </Grid>
            <ListView x:Name="ConvList" Grid.Row="2" ItemsSource="{x:Bind VM.Conversations}" SelectionMode="Single"
                      SelectionChanged="ConvList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationItem">
                        <Grid Padding="0,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="40" Height="40">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource StatusOnlineBrush}"
                                         Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" Visibility="{x:Bind ShowOnlineDot, Mode=OneWay}" />
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource StatusOfflineBrush}"
                                         Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" Visibility="{x:Bind ShowOfflineDot, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74F;" FontSize="11" Visibility="{x:Bind Muted, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind LastBody, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                                <Border Background="{ThemeResource UnreadBadgeBackgroundBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                        HorizontalAlignment="Right" Visibility="{x:Bind HasUnread, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource UnreadBadgeForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2" Margin="8,20" TextWrapping="Wrap"
                       Visibility="{x:Bind local:B.Empty(VM.Conversations.Count), Mode=OneWay}"
                       Text="还没有发现其他人。&#x0a;请确认对方也打开了本软件且在同一局域网；如果看不到，可以在上方输入对方 IP 直接添加，或到「诊断」页检查防火墙。" />
            <TextBlock Grid.Row="3" Style="{StaticResource SecondaryCaptionStyle}" Margin="4,0">
                <Run Text="在线：" /><Run Text="{x:Bind local:B.Str(VM.OnlineCount), Mode=OneWay}" /><Run Text="  ·  我：" /><Run Text="{x:Bind VM.MyName, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- Right: conversation -->
        <Grid Grid.Column="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              AllowDrop="True" DragOver="Conversation_DragOver" Drop="Conversation_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search results overlay / empty state -->
            <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind local:B.Not(VM.HasSelection), Mode=OneWay}">
                <FontIcon Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8BD;" FontSize="48" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择左侧的联系人或群组开始聊天" />
                <TextBlock Text="所有消息均端到端加密（Noise XX），只在局域网内传输" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="8" Visibility="{x:Bind VM.HasSelection, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Bind VM.SelectedTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind VM.SelectedSubtitle, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="信任" Command="{x:Bind VM.TrustSelectedCommand}" Visibility="{x:Bind VM.SelectedIsDm, Mode=OneWay}"
                            ToolTipService.ToolTip="核对对方指纹后标记为已信任（才能接收文件）" />
                    <Button Content="PIN 配对" Click="Pin_Click" Visibility="{x:Bind VM.SelectedIsDm, Mode=OneWay}" />
                    <Button Command="{x:Bind VM.ToggleMuteCommand}" ToolTipService.ToolTip="免打扰">
                        <FontIcon Glyph="&#xE7ED;" FontSize="14" />
                    </Button>
                    <Button x:Name="MoreButton" ToolTipService.ToolTip="更多">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="取消信任" Command="{x:Bind VM.UntrustSelectedCommand}" />
                                <MenuFlyoutItem Text="屏蔽" Command="{x:Bind VM.BlockSelectedCommand}" />
                                <MenuFlyoutItem Text="复制对方指纹" Click="CopyPeerFp_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="忘记此联系人" Click="Forget_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ListView x:Name="MessageList" Grid.Row="1" Padding="12,8" SelectionMode="None" IsItemClickEnabled="False"
                      ItemsSource="{x:Bind VM.Messages}" ItemTemplateSelector="{StaticResource MessageSelector}"
                      Visibility="{x:Bind VM.HasSelection, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <Grid Grid.Row="2" Padding="12" ColumnSpacing="8" Visibility="{x:Bind VM.HasSelection, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" VerticalAlignment="Bottom" Command="{x:Bind VM.AttachCommand}" ToolTipService.ToolTip="发送文件/图片（也可以直接拖进来）">
                    <FontIcon Glyph="&#xE723;" FontSize="16" />
                </Button>
                <TextBox x:Name="Composer" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                         PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行"
                         Text="{x:Bind VM.ComposeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Composer_PreviewKeyDown" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.SendCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                        <TextBlock Text="发送" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Search results as teaching tip style overlay -->
        <TeachingTip x:Name="SearchTip" Grid.Column="1" Title="搜索结果" PreferredPlacement="Center" IsLightDismissEnabled="True">
            <ListView ItemsSource="{x:Bind VM.SearchResults}" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SearchResult_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                        <StackPanel Padding="0,4">
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                <Run Text="{x:Bind SenderName}" /><Run Text="  " /><Run Text="{x:Bind TimeText}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" MaxLines="3" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TeachingTip>
    </Grid>
</Page>

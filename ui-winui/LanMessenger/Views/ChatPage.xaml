<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign (design/redesign/spec.md §2.4, §6.1; mockups winui-{light,dark}-chat.png):
     contact pane 320 (header 56, rows 68/72 pitch, avatar 48), chat header 64 (avatar 40), bubbles radius 8 capped at 480 with the
     time inside, date / E2E chips, file card 264 with a 44 type tile, composer 64 with a pill field and a round 40 send button. -->
<Page
    x:Class="LanMessenger.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    xmlns:vm="using:LanMessenger.Core.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="LsmChip" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Background" Value="{ThemeResource LsmChipBackgroundBrush}" />
        </Style>
        <Style x:Key="LsmChipText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource LsmChipForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="LsmImageTime" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#99000000" />
        </Style>

        <Style x:Key="LsmIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:MessageItem">
            <StackPanel Margin="0,1">
                <Border Style="{StaticResource LsmChip}" Visibility="{x:Bind HasDate, Mode=OneWay}">
                    <TextBlock Text="{x:Bind DateLabel, Mode=OneWay}" Style="{StaticResource LsmChipText}" />
                </Border>
                <Border Style="{StaticResource LsmChip}" Visibility="{x:Bind ShowE2E, Mode=OneWay}">
                    <TextBlock Text="消息已端到端加密，只有你和对方能看到" Style="{StaticResource LsmChipText}" />
                </Border>
                <Border HorizontalAlignment="Left" MaxWidth="480" CornerRadius="8" Padding="10,6"
                        Background="{ThemeResource LsmBubbleInBackgroundBrush}" Visibility="{x:Bind IsText, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind SenderName, Mode=OneWay}" Visibility="{x:Bind ShowSender, Mode=OneWay}" FontWeight="SemiBold"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource LsmBubbleInForegroundBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ClockText, Mode=OneWay}" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMetaBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Left" CornerRadius="12" Padding="0" BorderThickness="1" BorderBrush="{ThemeResource LsmDividerBrush}" Background="Transparent" Visibility="{x:Bind IsImage, Mode=OneWay}"><!-- parity with GTK: 1px edge, 12px corners clipped by the Border, no mat -->
                    <Grid>
                        <Image Source="{x:Bind FilePath, Mode=OneWay, Converter={StaticResource PathToImage}}" MaxHeight="200" MaxWidth="320" Stretch="Uniform" Tapped="Image_Tapped" />
                        <Border Style="{StaticResource LsmImageTime}"><TextBlock Text="{x:Bind ClockText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" /></Border>
                    </Grid>
                </Border>
                <Border HorizontalAlignment="Left" MinWidth="264" MaxWidth="360" CornerRadius="8" Padding="10,8" Background="{ThemeResource LsmBubbleInBackgroundBrush}"
                        Visibility="{x:Bind IsFileCard, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource LsmTileBackgroundBrush}">
                                <TextBlock Text="{x:Bind FileExt, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource LsmTileForegroundBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LsmBubbleInForegroundBrush}" />
                                <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMetaBrush}" />
                            </StackPanel>
                            <!-- incoming: download (save a copy where you want it); disabled while still receiving -->
                            <Button Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="18" Background="Transparent" BorderBrush="{ThemeResource LsmDividerBrush}" BorderThickness="1"
                                    Click="SaveAs_Click" IsEnabled="{x:Bind HasFilePath, Mode=OneWay}" ToolTipService.ToolTip="下载（另存为…）" AutomationProperties.Name="下载">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                        </Grid>
                        <Grid>
                            <HyperlinkButton Content="在文件夹中显示" Padding="0" FontSize="12" Click="RevealFile_Click" Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ClockText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMetaBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:MessageItem">
            <StackPanel Margin="0,1">
                <Border Style="{StaticResource LsmChip}" Visibility="{x:Bind HasDate, Mode=OneWay}">
                    <TextBlock Text="{x:Bind DateLabel, Mode=OneWay}" Style="{StaticResource LsmChipText}" />
                </Border>
                <Border Style="{StaticResource LsmChip}" Visibility="{x:Bind ShowE2E, Mode=OneWay}">
                    <TextBlock Text="消息已端到端加密，只有你和对方能看到" Style="{StaticResource LsmChipText}" />
                </Border>
                <Border HorizontalAlignment="Right" MaxWidth="480" CornerRadius="8" Padding="10,6"
                        Background="{ThemeResource LsmBubbleOutBackgroundBrush}" Visibility="{x:Bind IsText, Mode=OneWay}">
                    <StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource LsmBubbleOutForegroundBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Right"><TextBlock Text="{x:Bind ClockText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMineMetaBrush}" /><TextBlock Text="{x:Bind local:B.Tick(Tick), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMineMetaBrush}" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" /><FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource StatusErrorTextBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" CornerRadius="12" Padding="0" BorderThickness="1" BorderBrush="{ThemeResource LsmDividerBrush}" Background="Transparent" Visibility="{x:Bind IsImage, Mode=OneWay}"><!-- parity with GTK: 1px edge, 12px corners clipped by the Border, no mat -->
                    <Grid>
                        <Image Source="{x:Bind FilePath, Mode=OneWay, Converter={StaticResource PathToImage}}" MaxHeight="200" MaxWidth="320" Stretch="Uniform" Tapped="Image_Tapped" />
                        <Border Style="{StaticResource LsmImageTime}"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{x:Bind ClockText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" /><TextBlock Text="{x:Bind local:B.Tick(Tick), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" /></StackPanel></Border>
                    </Grid>
                </Border>
                <Border HorizontalAlignment="Right" MinWidth="264" MaxWidth="360" CornerRadius="8" Padding="10,8" Background="{ThemeResource LsmBubbleOutBackgroundBrush}"
                        Visibility="{x:Bind IsFileCard, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource LsmTileBackgroundBrush}">
                                <TextBlock Text="{x:Bind FileExt, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource LsmTileForegroundBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LsmBubbleOutForegroundBrush}" />
                                <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMineMetaBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource LsmIconButton}" Click="OpenFile_Click" ToolTipService.ToolTip="打开" Visibility="{x:Bind HasFilePath, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" Foreground="{ThemeResource LsmMineLinkBrush}" />
                            </Button>
                        </Grid>
                        <Grid>
                            <HyperlinkButton Content="在文件夹中显示" Padding="0" FontSize="12" Foreground="{ThemeResource LsmMineLinkBrush}" Click="RevealFile_Click" Visibility="{x:Bind HasFilePath, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Right"><TextBlock Text="{x:Bind ClockText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMineMetaBrush}" /><TextBlock Text="{x:Bind local:B.Tick(Tick), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource LsmMineMetaBrush}" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" /><FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource StatusErrorTextBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate" x:DataType="vm:MessageItem">
            <StackPanel Margin="0,1">
                <Border Style="{StaticResource LsmChip}" Visibility="{x:Bind HasDate, Mode=OneWay}">
                    <TextBlock Text="{x:Bind DateLabel, Mode=OneWay}" Style="{StaticResource LsmChipText}" />
                </Border>
                <Border Style="{StaticResource LsmChip}" Margin="40,4">
                    <TextBlock Text="{x:Bind Body, Mode=OneWay}" Style="{StaticResource LsmChipText}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <local:MessageTemplateSelector x:Key="MessageSelector"
            Incoming="{StaticResource IncomingTemplate}"
            Outgoing="{StaticResource OutgoingTemplate}"
            SystemNote="{StaticResource SystemTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: contact pane -->
        <Grid Grid.Column="0" Background="{ThemeResource LsmListBackgroundBrush}" BorderBrush="{ThemeResource LsmDividerBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="16,0,12,0">
                <TextBlock Text="聊天" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                    <Button x:Name="AddPeerButton" Style="{StaticResource LsmIconButton}" ToolTipService.ToolTip="按 IP 添加联系人 (Ctrl+N)" AutomationProperties.Name="添加联系人">
                        <FontIcon Glyph="&#xE8FA;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout x:Name="AddPeerFlyout" Placement="BottomEdgeAlignedLeft" Opened="AddPeerFlyout_Opened">
                                <StackPanel Width="340" Spacing="8">
                                    <TextBlock Text="按 IP 添加联系人" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="对方不在自动发现列表时，输入对方电脑的 IP（可带端口）。" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="AddPeerBox" PlaceholderText="如 192.168.1.20" Text="{x:Bind VM.AddPeerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="AddPeer_KeyDown" />
                                        <Button Grid.Column="1" Content="添加" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.AddPeerCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource LsmIconButton}" Click="NewGroup_Click" ToolTipService.ToolTip="新建群组">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="16,0,16,8" PlaceholderText="搜索聊天记录 (Ctrl+F)" QueryIcon="Find"
                            Text="{x:Bind VM.SearchText, Mode=TwoWay}" QuerySubmitted="Search_QuerySubmitted" Loaded="SearchBox_Loaded" />
            <ListView x:Name="ConvList" Grid.Row="2" Padding="4,0" RightTapped="ConvList_RightTapped" ItemsSource="{x:Bind VM.Conversations}" SelectionMode="Single"
                      SelectionChanged="ConvList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,0,8,0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="68" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationItem">
                        <Grid Height="68" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="48" Height="48">
                                <Ellipse Fill="{x:Bind local:B.Avatar(AvatarIndex), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                <!-- online dot with a 2px ring in the colour behind the avatar (list background, or the selected-row colour) -->
                                <Ellipse Tag="lsm-icon" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource StatusOnlineBrush}"
                                         Stroke="{ThemeResource LsmListBackgroundBrush}" StrokeThickness="2" Visibility="{x:Bind ShowOnlineDotIdle, Mode=OneWay}" />
                                <Ellipse Tag="lsm-icon" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource StatusOnlineBrush}"
                                         Stroke="{ThemeResource ListViewItemBackgroundSelected}" StrokeThickness="2" Visibility="{x:Bind ShowOnlineDotSelected, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE716;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsGroup}" />
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <FontIcon Tag="lsm-icon" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xEA18;" FontSize="12" Visibility="{x:Bind IsTrusted, Mode=OneWay}" ToolTipService.ToolTip="已验证身份" AutomationProperties.Name="已验证身份" />
                                    <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74F;" FontSize="12" Visibility="{x:Bind Muted, Mode=OneWay}" ToolTipService.ToolTip="免打扰" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="13">
                                    <Run Text="{x:Bind local:B.Tick(LastTick), Mode=OneWay}" /><Run Text="{x:Bind LastFrom, Mode=OneWay}" /><Run Text="{x:Bind Preview, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                <Border Background="{ThemeResource UnreadBadgeBackgroundBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0"
                                        HorizontalAlignment="Right" Visibility="{x:Bind HasUnread, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource UnreadBadgeForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2" Margin="20,20" TextWrapping="Wrap"
                       Visibility="{x:Bind local:B.Empty(VM.Conversations.Count), Mode=OneWay}"
                       Text="还没有发现其他人。&#x0a;请确认对方也打开了本软件且在同一局域网；如果看不到，可以点上方的“添加联系人”按 IP 直接添加，或到「诊断」页检查防火墙。" />
        </Grid>

        <!-- Right: conversation -->
        <Grid Grid.Column="1" Background="{ThemeResource LsmChatBackgroundBrush}"
              AllowDrop="True" DragOver="Conversation_DragOver" Drop="Conversation_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind local:B.Not(VM.HasSelection), Mode=OneWay}">
                <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8BD;" FontSize="48" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择左侧的联系人或群组开始聊天" />
                <TextBlock Text="所有消息均端到端加密（Noise XX），只在局域网内传输" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- chat header 64 -->
            <Grid Grid.Row="0" Height="64" Padding="16,0,12,0" ColumnSpacing="12" Visibility="{x:Bind VM.HasSelection, Mode=OneWay}"
                  Background="{ThemeResource LsmListBackgroundBrush}" BorderBrush="{ThemeResource LsmDividerBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Tapped="Details_Tapped" ToolTipService.ToolTip="联系人详情">
                    <Ellipse Fill="{x:Bind local:B.Avatar(VM.SelectedConversation.AvatarIndex), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind VM.SelectedConversation.Initial, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                    <Ellipse Tag="lsm-icon" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource StatusOnlineBrush}"
                             Stroke="{ThemeResource LsmListBackgroundBrush}" StrokeThickness="2" Visibility="{x:Bind VM.SelectedConversation.ShowOnlineDot, Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Tapped="Details_Tapped" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind VM.SelectedTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <!-- verified identity: green shield next to the name (mockup); the words are also in the subtitle -->
                        <FontIcon x:Name="HeaderShield" Tag="lsm-icon" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xEA18;" FontSize="13" VerticalAlignment="Center" Visibility="{x:Bind VM.SelectedTrusted, Mode=OneWay}" ToolTipService.ToolTip="已验证身份" AutomationProperties.Name="已验证身份" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind VM.SelectedSubtitle, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource LsmIconButton}" Click="FocusSearch_Click" ToolTipService.ToolTip="搜索聊天记录 (Ctrl+F)">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource LsmIconButton}" ToolTipService.ToolTip="更多">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="联系人详情" Click="Details_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="信任（核对指纹后）" Command="{x:Bind VM.TrustSelectedCommand}" Visibility="{x:Bind VM.SelectedIsDm, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="PIN 配对" Click="Pin_Click" Visibility="{x:Bind VM.SelectedIsDm, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="免打扰" Command="{x:Bind VM.ToggleMuteCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7ED;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="复制对方指纹" Click="CopyPeerFp_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="取消信任" Command="{x:Bind VM.UntrustSelectedCommand}" />
                                <MenuFlyoutItem Text="屏蔽" Command="{x:Bind VM.BlockSelectedCommand}" />
                                <MenuFlyoutItem Text="忘记此联系人" Click="Forget_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ListView x:Name="MessageList" Grid.Row="1" RightTapped="MessageList_RightTapped" Padding="16,8" SelectionMode="None" IsItemClickEnabled="False"
                      ItemsSource="{x:Bind VM.Messages}" ItemTemplateSelector="{StaticResource MessageSelector}"
                      Visibility="{x:Bind VM.HasSelection, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- composer 64 -->
            <Grid Grid.Row="2" MinHeight="64" Padding="12,12" ColumnSpacing="8" Visibility="{x:Bind VM.HasSelection, Mode=OneWay}"
                  Background="{ThemeResource LsmListBackgroundBrush}" BorderBrush="{ThemeResource LsmDividerBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource LsmIconButton}" VerticalAlignment="Bottom" Margin="0,0,0,2" Command="{x:Bind VM.AttachCommand}" ToolTipService.ToolTip="发送文件/图片（也可以直接拖进来）">
                    <FontIcon Glyph="&#xE723;" FontSize="16" />
                </Button>
                <TextBox x:Name="Composer" Grid.Column="1" Background="{ThemeResource LsmInputBackgroundBrush}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" MinHeight="40" CornerRadius="20" Padding="16,9,16,6"
                         PlaceholderText="输入消息" VerticalContentAlignment="Center"
                         Text="{x:Bind VM.ComposeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Composer_PreviewKeyDown" />
                <TextBlock Grid.Column="1" Text="Enter 发送 · Shift+Enter 换行" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                           Visibility="{x:Bind local:B.Empty(VM.ComposeText.Length), Mode=OneWay}" />
                <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" Padding="0" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind VM.SendCommand}" ToolTipService.ToolTip="发送 (Enter)" AutomationProperties.Name="发送">
                    <FontIcon Glyph="&#xE724;" FontSize="16" />
                </Button>
            </Grid>
        </Grid>

        <TeachingTip x:Name="SearchTip" Grid.Column="1" Title="搜索结果" PreferredPlacement="Center" IsLightDismissEnabled="True">
            <ListView ItemsSource="{x:Bind VM.SearchResults}" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SearchResult_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                        <StackPanel Padding="0,4">
                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}">
                                <Run Text="{x:Bind SenderName}" /><Run Text="  " /><Run Text="{x:Bind TimeText}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" MaxLines="3" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TeachingTip>
    </Grid>
</Page>

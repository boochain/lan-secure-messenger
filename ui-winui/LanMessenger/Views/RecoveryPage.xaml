<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.RecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Stretch" Margin="16,4,16,16">
            <TextBlock Text="恢复密钥" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="LSMF_recovery_key" />
            <TextBlock Text="这是你的账号恢复密钥。请把它抄到离线的安全地方。任何拿到这串密钥的人都能恢复你的身份。服务器看不到明文。"
                       TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.85" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <TextBlock x:Name="KeyText" FontFamily="Consolas" FontSize="20" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" HorizontalAlignment="Stretch" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyBtn" Content="复制" Click="Copy_Click" />
                <Button x:Name="ExportBtn" Content="导出到文件…" Click="Export_Click" />
            </StackPanel>
            <CheckBox x:Name="AckBox" Content="我已抄下并妥善保管" Click="Ack_Click" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConfirmBtn" Style="{StaticResource AccentButtonStyle}" Content="完成" Click="Done_Click" />
                <Button x:Name="BackBtn" Content="返回" Click="Back_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

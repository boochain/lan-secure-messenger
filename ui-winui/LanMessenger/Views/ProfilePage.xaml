<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch" Margin="16,4,16,16">
            <TextBlock Text="个人资料" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="LSMF_nav_profile" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBox Header="显示名称" Text="{x:Bind VM.EditDisplayName, Mode=TwoWay}" MaxLength="40" />
                    <TextBlock Text="身份指纹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind VM.MyFingerprint, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                        <Button Content="复制" Command="{x:Bind VM.CopyFingerprintCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="头像与个性签名…" Click="Avatar_Click" />
                        <Button Content="我的二维码…" Click="Qr_Click" Tag="LSMF_qr_profile" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="保存" Command="{x:Bind VM.SaveSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

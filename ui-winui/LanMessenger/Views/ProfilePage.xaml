<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanMessenger.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch" Margin="16,4,16,16">
            <TextBlock Text="个人资料" Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="LSMF_nav_profile" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                        <Button Style="{StaticResource LsmActionButtonStyle}" Click="Avatar_Click" ToolTipService.ToolTip="头像与个性签名">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource LsmIconTileStyle}">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="头像" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LsmActionButtonStyle}" Click="Qr_Click" Tag="LSMF_qr_profile" ToolTipService.ToolTip="我的二维码">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource LsmIconTileStyle}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="二维码" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LsmActionButtonStyle}" Command="{x:Bind VM.CopyFingerprintCommand}" ToolTipService.ToolTip="复制指纹">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource LsmIconTileStyle}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="复制" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LsmActionButtonStyle}" Command="{x:Bind VM.SaveSettingsCommand}" ToolTipService.ToolTip="保存">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource LsmIconTileStyle}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="保存" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBox Header="显示名称" Text="{x:Bind VM.EditDisplayName, Mode=TwoWay}" MaxLength="40" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource LsmIconTileStyle}">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource LsmTileForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="身份指纹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind VM.MyFingerprint, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

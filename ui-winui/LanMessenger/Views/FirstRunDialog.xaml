<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LanMessenger.Views.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="欢迎使用局域网安全通讯"
    PrimaryButtonText="开始使用"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick">
    <!-- Scroll the intro; pin the firewall hint so it is never clipped above 开始使用. -->
    <Grid MaxWidth="480" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="请选择身份方式。只问这一次，之后在设置里改。选账号模式会接着填写中转服务器和账号密码。" />
                <RadioButton x:Name="DeviceModeRadio" GroupName="AcctMode" IsChecked="True" Checked="Mode_Checked" Tag="LSMF_account_mode" Style="{StaticResource ChoiceCardRadioStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE774;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="设备模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="仅本机，局域网直连" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AccountModeRadio" GroupName="AcctMode" Checked="Mode_Checked" Style="{StaticResource ChoiceCardRadioStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="账号模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="中转服务器上的账号，换机用同一账号密码" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <StackPanel x:Name="AccountExtra" Visibility="Collapsed" Spacing="8">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="填写你自己的中转服务器，再用账号密码注册或登录。服务器只存口令哈希，聊天记录用这个密码加密后上传。" />
                    <TextBox x:Name="RelayHostBox" Header="中转服务器地址" PlaceholderText="例如 192.168.1.2" />
                    <TextBox x:Name="RelayPortBox" Header="端口" Text="9443" />
                    <PasswordBox x:Name="RelayPassBox" Header="网络口令（开放中转留空）" />
                    <TextBox x:Name="AcctUserBox" Header="账号" />
                    <PasswordBox x:Name="AcctPassBox" Header="密码（至少 8 位）" />
                    <RadioButton x:Name="RegRadio" GroupName="AcctAct" IsChecked="True" Content="注册新账号" />
                    <RadioButton x:Name="LoginRadio" GroupName="AcctAct" Content="登录已有账号" />
                </StackPanel>
                <TextBox x:Name="NameBox" Header="你的显示名称（别人看到的名字）" MaxLength="40" />
                <StackPanel Spacing="4">
                    <TextBlock Text="你的身份指纹（可让对方核对，防止冒充）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FpText" Grid.Column="0" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="复制" Click="CopyFp_Click" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
            <InfoBar x:Name="FwInfo" IsOpen="True" IsClosable="False" Severity="Warning" Title="Windows 防火墙"
                     Message="为了让其他电脑能发现并连接到你，需要允许本程序通过防火墙（专用网络）。点击下方按钮，系统会弹出一次管理员确认。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="FwButton" Style="{StaticResource AccentButtonStyle}" Content="一键配置防火墙" Click="Firewall_Click" />
                <ProgressRing x:Name="FwRing" Width="20" Height="20" IsActive="False" />
            </StackPanel>
            <TextBlock x:Name="FwResult" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LanMessenger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanMessenger"
    Title="LAN Secure Messenger">
    <Grid x:Name="RootGrid" Language="zh-CN">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="ms-appx:///Assets/app.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="局域网安全通讯 · LAN Secure Messenger" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource OnlineBrush}" Visibility="{x:Bind VM.IsConnected, Mode=OneWay}" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" Visibility="{x:Bind local:B.Not(VM.IsConnected), Mode=OneWay}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind VM.ConnectionText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="12,0,12,4" IsClosable="True"
                 IsOpen="{x:Bind VM.HasStatus, Mode=OneWay}"
                 Message="{x:Bind VM.StatusMessage, Mode=OneWay}"
                 Closed="StatusBar_Closed" />

        <NavigationView x:Name="Nav" Grid.Row="2"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="聊天" Tag="chat">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="群组" Tag="groups">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="传输" Tag="transfers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="diag">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
